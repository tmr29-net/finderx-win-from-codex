<Window x:Class="Findr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Findr"
        Title="FinderX for Windows" Height="800" Width="1280" MinHeight="600" MinWidth="900"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="#202735"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <local:PathToImageConverter x:Key="PathToImage" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5367D8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4357C4" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#778196" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7EAF0" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#465064" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E9ECF5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DDE2F0" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#505B70" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" /><Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#263044" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,3" /><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="Image"><Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" /><Setter Property="SnapsToDevicePixels" Value="True" /></Style>
        <Style TargetType="TabControl"><Setter Property="Padding" Value="4,3" /></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#657086" /><Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="2,4,2,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabChrome" Background="Transparent" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#F0F2FC"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#F0F2F7"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="#505B70" /><Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="7,5" /><Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#F0F3FA"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#E8ECFC"/><Setter Property="Foreground" Value="#283B91"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="#7A8498" /><Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="8,8" />
            <Setter Property="BorderBrush" Value="#ECEEF3" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="TileTemplate">
            <Border Width="148" Height="132" Margin="7" Padding="13" Background="White" CornerRadius="12" BorderBrush="#E7EAF0" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <Grid Height="44" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IconResource}" Value="{x:Null}"/><Condition Binding="{Binding IconPath}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Image Source="{Binding IconResource}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="34" Foreground="#505B70" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <ContextMenu x:Key="EntryMenu">
            <MenuItem Header="開く" Click="OpenMenu_Click" /><MenuItem Header="フォルダーを開く" Click="OpenFolderMenu_Click" />
            <Separator />
            <MenuItem Header="切り取り" Click="CutMenu_Click"><MenuItem.Icon><Image Source="/Assets/Icons/cut.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="コピー" Click="CopyMenu_Click"><MenuItem.Icon><Image Source="/Assets/Icons/copy.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="貼り付け" Click="PasteMenu_Click"><MenuItem.Icon><Image Source="/Assets/Icons/paste.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
            <Separator /><MenuItem Header="名前の変更" Click="RenameMenu_Click" />
            <MenuItem Header="削除" Click="DeleteMenu_Click"><MenuItem.Icon><Image Source="/Assets/Icons/delete.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
            <MenuItem Header="フォルダーアイコンを変更" Click="IconMenu_Click" /><MenuItem Header="お気に入りに追加" Click="FavoriteMenu_Click" />
            <Separator /><MenuItem Header="プロパティ" Click="PropertiesMenu_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,9">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#EEF0FF" Margin="0,0,10,0">
                        <Grid><TextBlock Text="▱" FontSize="23" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="✦" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,6,0"/></Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="FinderX" FontSize="16" FontWeight="Bold" Foreground="#222B3B"/><TextBlock Text="FOR WINDOWS" FontSize="9" FontWeight="SemiBold" Foreground="#929AAD"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="戻る" Click="Back_Click"><Image Source="/Assets/Icons/back.png" Width="18" Height="18"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="進む" Click="Forward_Click"><Image Source="/Assets/Icons/forward.png" Width="18" Height="18"/></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="上の階層" Click="Up_Click"><Image Source="/Assets/Icons/upward.png" Width="18" Height="18"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="＋  新しいタブ" Click="NewTab_Click" />
                    <Button Style="{StaticResource IconButton}" Content="▦" ToolTip="詳細表示 / 大アイコン表示" Click="View_Click" />
                </StackPanel>
                <Border Background="#F5F6F9" BorderBrush="#ECEEF3" BorderThickness="1" CornerRadius="9" Margin="18,2,12,2" Padding="9,0" VerticalAlignment="Center" Height="40">
                    <DockPanel>
                        <TextBlock Text="⌕" FontSize="22" Foreground="#858EA1" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" MinWidth="180" Height="34" ToolTip="このフォルダーとサブフォルダーを検索" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                        <Button Content="検索" Click="Search_Click" Padding="12,5" Margin="5,0,0,0" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Content="＋" ToolTip="新しいタブ" Click="NewTab_Click" Margin="4,4,14,4" />
                <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" SelectionChanged="Tabs_SelectionChanged" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F0F2F7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,20">
                    <TextBlock Text="場所" FontSize="10" FontWeight="Bold" Foreground="#929AAD" Margin="11,0,0,8" />
                    <Button Style="{StaticResource NavButton}" Content="⌂    ホーム" Tag="HOME" Click="QuickLocation_Click" />
                    <Button Style="{StaticResource NavButton}" Tag="DESKTOP" Click="QuickLocation_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Icons/desktop.png" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="デスクトップ" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="DOCUMENTS" Click="QuickLocation_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Icons/document.png" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="ドキュメント" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="DOWNLOADS" Click="QuickLocation_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Icons/download.png" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="ダウンロード" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="PICTURES" Click="QuickLocation_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Icons/picture.png" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="画像" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Tag="PC" Click="QuickLocation_Click"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Icons/computer.png" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="PC" VerticalAlignment="Center"/></StackPanel></Button>
                    <TextBlock Text="お気に入り" FontSize="10" FontWeight="Bold" Foreground="#929AAD" Margin="11,24,0,8" />
                    <ItemsControl x:Name="FavoritesList" />
                    <TextBlock Text="最近使った場所" FontSize="10" FontWeight="Bold" Foreground="#929AAD" Margin="11,24,0,8" />
                    <ItemsControl x:Name="RecentList" />
                </StackPanel></ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Background="#F8F9FB">
                <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="22,7,20,4">
                    <Button DockPanel.Dock="Right" Content="⋯" Click="More_Click" ToolTip="新規フォルダーなど" FontSize="18" Padding="10,3" />
                    <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" VerticalAlignment="Center" />
                </DockPanel>
                <ListView x:Name="FileList" Grid.Row="1" Margin="14,0,14,14" Background="White" SelectionMode="Extended" ContextMenu="{StaticResource EntryMenu}" MouseDoubleClick="FileList_MouseDoubleClick" PreviewMouseMove="FileList_PreviewMouseMove" SelectionChanged="FileList_SelectionChanged" AllowDrop="True" Drop="FileList_Drop">
                    <ListView.View><GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="名前" Width="410"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="30" Height="26" Margin="0,0,5,0"><TextBlock Text="{Binding Icon}" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IconResource}" Value="{x:Null}"/><Condition Binding="{Binding IconPath}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding IconResource}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="種類" Width="150" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="サイズ" Width="105" DisplayMemberBinding="{Binding Size}" />
                        <GridViewColumn Header="更新日時" Width="170" DisplayMemberBinding="{Binding Modified, StringFormat={}{0:yyyy/MM/dd HH:mm}}" />
                    </GridView></ListView.View>
                </ListView>
            </Grid>
            <Border x:Name="PreviewPanel" Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20">
                <StackPanel>
                    <DockPanel><TextBlock Text="プレビュー" FontWeight="SemiBold" FontSize="15"/><Button DockPanel.Dock="Right" Content="×" Click="ClosePreview_Click" Padding="8,2" /></DockPanel>
                    <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,10" />
                    <Image x:Name="PreviewImage" MaxHeight="250" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewDetails" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,15,0,8" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" /></ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBlock x:Name="PathText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#929AAD" FontSize="10" TextTrimming="CharacterEllipsis" /></DockPanel>
        </Border>
    </Grid>
</Window>
